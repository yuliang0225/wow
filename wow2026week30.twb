            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='GrandSlamsOnly' caption='pGrandSlamsOnly' datatype='boolean' name='[Parameter 1840065726255107]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='All' />
                <alias key='true' value='GrandSlamsOnly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sxtn3114z6hgl1dk85f41vfy3hp'>
            <column caption='Best round' datatype='integer' name='[Calculation_1807698837450755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [Date] : MIN([Calculation_1840065724493826]) }' />
            </column>
            <column caption='Is Winner?' datatype='boolean' name='[Calculation_1840065722986496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(TRIM( SPLIT( [Match], &quot;d.&quot;, 1 ) ),&quot;Sinner&quot;)' />
            </column>
            <column caption='Round Pos' datatype='integer' name='[Calculation_1840065724493826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Round]&#10;WHEN &apos;F&apos; THEN 1&#10;WHEN &apos;SF&apos; THEN 2&#10;WHEN &apos;QF&apos; THEN 3&#10;WHEN &apos;R16&apos; THEN 4&#10;WHEN &apos;R32&apos; THEN 5&#10;WHEN &apos;R64&apos; THEN 6&#10;WHEN &apos;R128&apos; THEN 7&#10;WHEN &apos;Q3&apos; THEN 8&#10;WHEN &apos;Q2&apos; THEN 9&#10;WHEN &apos;Q1&apos; THEN 10&#10;WHEN &apos;RR&apos; THEN 11&#10;END' />
            </column>
            <column caption='Filter-Matches' datatype='boolean' name='[Calculation_1840065726496772]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1840065726255107] then [Tournament Set] else true end' />
            </column>
            <column caption='Keep best round only' datatype='boolean' name='[Calculation_1840065727606789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1840065724493826] = [Calculation_1807698837450755]' />
            </column>
            <column caption='Label unranked' datatype='string' name='[Calculation_1840065729593351]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([Rank]),&apos;Unranked&apos;,NULL)' />
