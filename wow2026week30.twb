      <column caption='Keep best round only' datatype='boolean' name='[Calculation_1840065727606789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1840065724493826] = [Calculation_1807698837450755]' />
      </column>
      <column caption='Label unranked' datatype='string' name='[Calculation_1840065729593351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([Rank]),&apos;Unranked&apos;,NULL)' />
